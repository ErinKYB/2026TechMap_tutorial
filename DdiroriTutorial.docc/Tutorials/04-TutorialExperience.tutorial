@Tutorial(time: 30) {
    @Intro(title: "시뮬레이터와 완성된 학습 흐름 연결하기") {
        가이드 시범, 커서 입력, 검지 파티클, 추적 유실 안내와 세 번 연속 성공을 하나의 상태 모델로 연결합니다.

        @Image(source: tutorial-flow.svg, alt: "시작부터 시범, 연습, 추적 중단, 완료로 이어지는 튜토리얼 상태 흐름")
    }

    @Section(title: "시뮬레이터 입력 제공하기") {
        @ContentAndMedia {
            visionOS Simulator는 실제 Hand Tracking 데이터를 제공하지 않습니다. 드래그 가능한 가상 검지 Entity가 `FingerTrackingSample`을 만들도록 하면 실제 기기와 완전히 같은 판정 로직을 테스트할 수 있습니다.

            @Image(source: ddirori-practice.png, alt: "커서로 가상 검지 구체를 이동하는 Beat Zone 연습 화면")
        }

        @Steps {
            @Step {
                `SimulatedHandTrackingService`가 현재 커서 위치를 추적된 샘플로 방출하게 합니다.

                @Code(name: "SimulatedHandTrackingService.swift", file: SimulatedHandTrackingService.swift)
            }

            @Step {
                가상 검지 Entity에 `InputTargetComponent`, Collision과 Hover Effect를 추가합니다. 실제 기기 모드에서는 같은 Entity를 표시 전용으로 사용합니다.

                @Code(name: "FingertipEntity.swift", file: FingertipEntity.swift)
            }

            @Step {
                `RealityView`의 targeted drag gesture에서 공간 좌표를 변환하고 ViewModel에 전달합니다.

                @Code(name: "ImmersiveView.swift", file: ImmersiveView.swift)
            }
        }
    }

    @Section(title: "상태와 화면 연결하기") {
        @ContentAndMedia {
            렌더링 코드가 직접 판정하지 않도록 ViewModel이 추적 입력, 순서 컨트롤러, 상태 전이를 조정합니다. SwiftUI와 RealityKit은 상태를 관찰해 표현만 갱신합니다.

            @Image(source: tutorial-flow.svg, alt: "튜토리얼 상태 머신")
        }

        @Steps {
            @Step {
                시작 전, 보정, 시범, 연습, 사이클 성공, 추적 중단, 완료와 오류 상태를 정의합니다.

                @Code(name: "TutorialPhase.swift", file: TutorialPhase.swift)
            }

            @Step {
                서비스의 `samples`를 순회하고 연습 상태에서만 `BeatSequenceController`에 전달합니다.

                @Code(name: "TutorialViewModel.swift", file: TutorialViewModel.swift)
            }

            @Step {
                추적이 잠깐 끊기면 판정을 멈추고 손을 시야 안으로 가져오라는 메시지를 표시합니다. 장기 유실 시에는 연속 성공을 초기화합니다.
            }

            @Step {
                한 사이클 성공 연출 동안 입력을 잠그고, 세 번째 연속 성공 뒤 완료 상태로 전환합니다.
            }
        }
    }

    @Section(title: "두 환경에서 검증하기") {
        @Steps {
            @Step {
                visionOS Simulator에서 시뮬레이션 모드를 선택하고 가상 검지를 `1 → 2 → 3 → 4` 순서로 드래그합니다.
            }

            @Step {
                한 Zone 내부에 계속 머물러도 한 번만 처리되고, 다른 Zone을 먼저 지나가도 현재 Beat가 바뀌지 않는지 확인합니다.
            }

            @Step {
                Apple Vision Pro에서 실기기 모드를 선택하고 검지 구체와 파티클, 손 추적 권한, 좌표 정렬을 확인합니다.
            }

            @Step {
                세 사이클 연속 성공 후 완료 피드백이 나타나고 Immersive Space가 안전하게 종료되는지 확인합니다.
            }
        }
    }
}
