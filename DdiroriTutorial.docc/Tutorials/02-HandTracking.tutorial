@Tutorial(time: 25) {
    @Intro(title: "양손의 검지 끝을 공간 좌표로 변환하기") {
        `ARKitSession`과 `HandTrackingProvider`를 실행하고, 사용 중인 손을 안정적으로 선택한 뒤 검지 끝 Joint를 Immersive Space 좌표로 변환합니다.

        @Image(source: hand-transform.svg, alt: "손 Anchor와 검지 끝 Joint 변환을 결합하는 흐름")
    }

    @Section(title: "손 추적 스트림 시작하기") {
        @ContentAndMedia {
            `HandTrackingService`가 ARKit 세션과 `AsyncStream`을 함께 소유합니다. View는 ARKit을 직접 다루지 않고, ViewModel이 `FingerTrackingSample` 스트림만 소비합니다.
        }

        @Steps {
            @Step {
                위치, 손 방향, 추적 여부와 시간을 담는 `FingerTrackingSample`을 정의하고 서비스에 샘플 스트림을 추가합니다.

                @Code(name: "HandTrackingService.swift", file: "hand-tracking-01.swift")
            }

            @Step {
                `HandTrackingProvider.isSupported`와 권한 결과를 확인한 다음 `session.run`을 호출합니다. 지원되지 않거나 권한이 거부되면 사용자가 이해할 수 있는 오류를 던집니다.

                @Code(name: "HandTrackingService.swift", file: "hand-tracking-02.swift")
            }

            @Step {
                `anchorUpdates`를 비동기로 순회하면서 왼손과 오른손의 최신 Anchor를 각각 저장합니다.

                @Code(name: "HandTrackingService.swift", file: "hand-tracking-03.swift")
            }
        }
    }

    @Section(title: "사용 중인 손을 고정하고 좌표 계산하기") {
        @ContentAndMedia {
            양손을 모두 허용하되, 한번 선택한 손이 계속 추적되는 동안은 그 손을 유지합니다. 이렇게 해야 왼손으로 지휘하는 중 오른손이 잠깐 보이더라도 입력이 갑자기 바뀌지 않습니다.

            @Image(source: hand-transform.svg, alt: "선택한 손 Anchor에서 검지 끝 공간 위치를 계산하는 다이어그램")
        }

        @Steps {
            @Step {
                현재 손이 유효하면 그대로 사용하고, 유실됐을 때만 선호 손과 반대 손의 순서로 새 Anchor를 선택합니다.

                @Code(name: "HandTrackingService.swift", file: "hand-tracking-04.swift")
            }

            @Step {
                Hand Anchor의 `originFromAnchorTransform`과 검지 끝의 `anchorFromJointTransform`을 곱하고, 결과 행렬의 네 번째 열에서 위치를 꺼냅니다.

                @Code(name: "HandTrackingService.swift", file: "hand-tracking-05.swift")
            }

            @Step {
                Anchor나 Joint가 유효하지 않으면 이전 위치를 재사용하지 말고 `position == nil`, `isTracked == false`인 샘플을 방출합니다.

                @Code(name: "HandTrackingService.swift", file: "hand-tracking-05.swift")
            }
        }
    }

    @Section(title: "Apple Vision Pro에서 확인하기") {
        @Steps {
            @Step {
                실기기에서 앱의 Hand Tracking 권한을 허용하고 오른손 또는 왼손 검지를 움직입니다.
            }

            @Step {
                흰색 검지 구체가 먼저 사용한 손을 따라오는지, 그 손이 시야를 벗어나면 반대 손으로 자연스럽게 전환되는지 확인합니다.
            }

            @Step {
                손을 시야 밖으로 빼면 검지 표시와 판정이 멈추고 안내가 나타나는지 확인합니다.
            }
        }
    }
}
