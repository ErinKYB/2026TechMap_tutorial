@Tutorial(time: 20) {
    @Intro(title: "반짝이는 궤적으로 지휘 자세 안내하기") {
        본격적으로 손동작을 인식하기 전에, 사용자에게 먼저 4/4박자 지휘 패턴이
        어떻게 움직이는지 보여주는 온보딩 화면을 만듭니다. `WindowGroup`(평범한 창)
        안에서 SwiftUI로 궤적 선을 반복 재생하고, 그 위에 RealityKit
        `ParticleEmitterComponent`로 반짝이는 파티클이 경로를 따라 흐르게 한 뒤,
        "이제 이 동작을 따라해보세요!" 안내와 "시작하기" 버튼으로 마무리합니다.

        몰입형 공간(`ImmersiveSpace`)으로 가지 않고도, `RealityView`는 평범한 창
        안에서도 내부 콘텐츠를 실제 스테레오 깊이감으로 렌더링합니다. 창 자체는
        평평하지만 그 안의 3D 콘텐츠는 "창 너머로 보이는 디오라마"처럼 보이므로,
        이 온보딩 화면만으로도 visionOS 플랫폼의 공간감을 살릴 수 있습니다.

        @Image(source: ddirori-hero.png, alt: "반짝이는 파티클이 지휘 궤적을 따라 움직이는 온보딩 화면")
    }

    @Section(title: "지휘 궤적을 반복 애니메이션으로 그리기") {
        @ContentAndMedia {
            지휘 궤적 선(SwiftUI)과 파티클(RealityKit)은 서로 다른 렌더링
            시스템이라, 좌표를 하나의 원본 데이터로 공유하는 것이 핵심입니다.
            먼저 4/4박자 각 지점을 -1...1 범위의 정규화 좌표로 정의하고, 진행률
            t(0...1)로 경로 위 아무 지점이나 계산할 수 있는 함수를 만든 뒤,
            그 경로를 SwiftUI `Path`로 그려 반복 재생합니다.

            @Image(source: OnboardingUI1.png, alt: "4/4박자 지휘 패턴 경로 다이어그램")
        }

        @Steps {
            @Step {
                4/4박자 각 박자(1박 아래 → 2박 왼쪽 → 3박 오른쪽 → 4박 위)를
                `ConductingBeat` 열거형으로 정의합니다. 좌표는 중심을 기준으로 한
                정규화 오프셋(-1...1)이며, 4박 다음은 다시 1박으로 이어지는 닫힌
                경로입니다.

                @Code(name: "ConductingBeat.swift", file: "ob-conducting-beat.swift")
            }

            @Step {
                `ConductingPath`에 경로 좌표 목록과, 진행률 t(0...1)에 해당하는
                좌표를 선형 보간으로 계산하는 함수를 추가합니다. t가 1을 넘어가면
                자동으로 0부터 다시 감싸져 무한 반복을 지원합니다. 이 함수가
                이후 SwiftUI 선과 RealityKit 파티클 양쪽에서 공유하는 유일한
                원본이 됩니다.

                @Code(name: "ConductingPath.swift", file: "ob-conducting-path.swift")
            }

            @Step {
                `Shape` 프로토콜을 채택한 `BeatPathShape`로 `ConductingPath`의
                좌표를 뷰 크기에 맞게 투영해 닫힌 경로를 그립니다.

                @Code(name: "BeatPathShape.swift", file: "ob-beat-path-shape.swift")
            }

            @Step {
                `ConductingPathTraceView`에서 `.trim(from:to:)`을 0에서 1까지
                애니메이션시키고 `repeatForever`로 반복시켜, 궤적 선이 계속
                그려졌다가 다시 처음부터 그려지는 데모 애니메이션을 완성합니다.

                @Code(name: "ConductingPathTraceView.swift", file: "ob-path-trace-view.swift")
            }
        }
    }

    @Section(title: "RealityKit 파티클로 궤적 위에 반짝이는 가루 흘리기") {
        @ContentAndMedia {
            파티클 이미터는 별도로 Reality Composer Pro에서 제작한
            `ParticleEmitterComponent` 엔티티("2meter")를 그대로 불러와
            사용합니다. 이 파티클을 경로 위에서 움직이게 하려면, 앞 절에서 만든
            정규화 좌표를 RealityKit의 미터 단위 월드 좌표로 변환하고, 매 프레임
            이미터의 위치를 갱신해야 합니다.

            @Image(source: OnboardingUI2.png, alt: "파티클 이미터가 경로를 따라 이동하는 흐름")
        }

        @Steps {
            @Step {
                궤적 선 애니메이션(SwiftUI)과 파티클 이동(RealityKit)이 같은
                주기로 반복되도록, `ConductingAnimationTiming`에 템포와 한 바퀴
                도는 시간을 공유 상수로 정의합니다.

                @Code(name: "ConductingAnimationTiming.swift", file: "ob-animation-timing.swift")
            }

            @Step {
                `ConductingWorldMapping`으로 정규화 좌표(-1...1)를 RealityKit
                월드 좌표(미터)로 변환합니다. RealityKit은 +y가 위쪽이라,
                "아래+"로 정의했던 정규화 좌표의 y 부호를 뒤집어야 궤적 선과
                파티클이 같은 방향으로 움직입니다.

                @Code(name: "ConductingWorldMapping.swift", file: "ob-world-mapping.swift")
            }

            @Step {
                `ConductingParticleTrailController`에서 파티클 이미터("2meter")를
                불러와 씬에 추가하고, `content.subscribe(to: SceneEvents.Update.self)`로
                RealityKit의 프레임 콜백을 구독해 매 프레임 이미터 위치를
                갱신합니다. SwiftUI `@State`를 프레임마다 갱신하는 대신 RealityKit
                자체 루프를 쓰는 이유는 성능 때문입니다.

                @Code(name: "ConductingParticleTrailController.swift", file: "ob-particle-controller.swift")
            }

            @Step {
                이 컨트롤러를 감싸는 `ConductingParticleTrailView`를 만듭니다.
                `RealityView`가 평범한 `WindowGroup` 안에 놓여도, 그 안의 파티클은
                여전히 실제 3D 깊이감으로 렌더링됩니다.

                @Code(name: "ConductingParticleTrailView.swift", file: "ob-particle-view.swift")
            }
        }
    }

    @Section(title: "안내 문구와 시작하기 버튼으로 온보딩 마무리하기") {
        @ContentAndMedia {
            궤적 애니메이션과 파티클 위에 안내 문구와 "시작하기" 버튼을 얹어
            온보딩 화면을 완성합니다. 배경을 투명하게 유지해, 아래 겹쳐진
            궤적/파티클 레이어가 그대로 비치도록 합니다.

            @Image(source: OnboardingUI2.png, alt: "안내 문구와 시작하기 버튼이 있는 완성 화면")
        }

        @Steps {
            @Step {
                "이제 이 동작을 따라해보세요!"에 해당하는 안내 문구와 "시작하기"
                버튼을 담은 `OnboardingPromptOverlay`를 만듭니다. 버튼을 눌렀을
                때 할 동작은 `onStart` 클로저로 바깥에서 주입받습니다.

                @Code(name: "OnboardingPromptOverlay.swift", file: "ob-prompt-overlay.swift")
            }

            @Step {
                마지막으로 `ConductorOnboardingView`에서 궤적 선, 파티클,
                안내 UI 세 레이어를 `ZStack`으로 겹쳐 온보딩 화면을 완성합니다.
                이 뷰를 `WindowGroup`에 그대로 올리면 됩니다.

                @Code(name: "ConductorOnboardingView.swift", file: "ob-onboarding-view.swift")
            }
        }
    }
}
