@Tutorial(time: 20) {
    @Intro(title: "Immersive Space에서 지휘 동작 안내하기") {
        실제 연습을 시작하기 전에 4/4박자 경로를 반복해서 그리는 온보딩을 만듭니다. 최종 앱은 별도 창이나 파티클 이미터 대신 SwiftUI 경로를 RealityView attachment로 공간 안에 직접 배치합니다.

        @Image(source: OnboardingUI1.png, alt: "Immersive Space에 표시된 4/4박자 지휘 온보딩")
    }

    @Section(title: "연습과 같은 경로 그리기") {
        @ContentAndMedia {
            온보딩과 실제 Beat Zone이 서로 다른 좌표 원본을 사용하면 화면이 전환될 때 경로가 튀어 보입니다. `ConductingBeat`의 정규화 좌표를 공통 원본으로 삼고, 2D와 3D가 같은 배치 수식을 공유하게 만듭니다.

            @Image(source: OnboardingUI1.png, alt: "네 개의 박자 위치를 잇는 지휘 경로")
        }

        @Steps {
            @Step {
                1박 아래, 2박 왼쪽, 3박 오른쪽, 4박 위의 정규화 좌표를 `ConductingBeat`에 정의합니다.

                @Code(name: "ConductingBeat.swift", file: "onboarding-conducting-beat.swift")
            }

            @Step {
                `ConductingLayout`에서 `BeatZoneLayout`의 위치를 SwiftUI 포인트 좌표로 바꿉니다. RealityKit의 y축과 SwiftUI의 y축 방향이 반대이므로 부호를 뒤집습니다.

                @Code(name: "ConductingLayout.swift", file: "onboarding-layout.swift")
            }

            @Step {
                `BeatPathShape`가 네 지점을 닫힌 경로로 연결하도록 구현합니다.

                @Code(name: "BeatPathShape.swift", file: "onboarding-path-01.swift")
            }

            @Step {
                `.trim(from:to:)`과 반복 애니메이션으로 경로가 계속 그려지게 합니다.

                @Code(name: "ConductingPathTraceView.swift", file: "onboarding-path-02.swift")
            }
        }
    }

    @Section(title: "안내와 시작 버튼 겹치기") {
        @ContentAndMedia {
            경로 위에 동작 설명과 시작 버튼을 배치합니다. 최종 앱은 시범용 점 파티클을 사용하지 않아 초보자가 SwiftUI 경로와 공간 배치에 집중할 수 있습니다.

            @Image(source: OnboardingUI2.png, alt: "지휘 동작 설명과 시작하기 버튼이 있는 온보딩")
        }

        @Steps {
            @Step {
                안내 문구와 시작 버튼을 실제 연습의 진행 표시와 종료 버튼에 대응하는 위치에 놓습니다.

                @Code(name: "OnboardingPromptOverlay.swift", file: "onboarding-overlay.swift")
            }

            @Step {
                경로와 오버레이를 `ZStack`으로 합쳐 `ConductorOnboardingView`를 완성합니다.

                @Code(name: "ConductorOnboardingView.swift", file: "onboarding-view.swift")
            }

            @Step {
                `ImmersiveView`의 attachment로 온보딩을 만들고 `zoneCenter`에 배치합니다. 시범 중에는 온보딩만, 연습 중에는 Beat Zone 그룹만 활성화합니다.

                @Code(name: "ImmersiveView.swift", file: "onboarding-immersive-view.swift")
            }
        }
    }
}
