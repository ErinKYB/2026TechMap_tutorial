@Tutorial(time: 30) {
    @Intro(title: "Beat Zone과 순서 판정 만들기") {
        RealityKit 공간에 네 개의 Beat Zone을 배치하고, 거리와 바깥→안쪽 경계 진입을 이용해 `1 → 2 → 3 → 4` 순서를 중복 없이 판정합니다.

        @Image(source: ddirori-practice.png, alt: "1, 2, 3, 4 Beat Zone과 손가락 표시가 있는 연습 화면")
    }

    @Section(title: "조정 가능한 공간 배치") {
        @ContentAndMedia {
            Zone 크기, 간격, 판정 반경과 입력 잠금 시간을 한 구조체에서 관리하면 실기기 테스트 후 값을 빠르게 튜닝할 수 있습니다. 시각 반경보다 판정 반경을 조금 크게 두어 추적 흔들림을 흡수합니다.

            @Image(source: ddirori-practice.png, alt: "다이아몬드 모양으로 배치된 네 Beat Zone")
        }

        @Steps {
            @Step {
                `TutorialConfiguration`에 Zone 중심, 좌우·상하 간격, 시각 반경과 판정 반경을 정의합니다.

                @Code(name: "TutorialConfiguration.swift", file: TutorialConfiguration.swift)
            }

            @Step {
                1박은 아래, 2박은 왼쪽, 3박은 오른쪽, 4박은 위가 되도록 공통 공간 좌표를 계산합니다.

                @Code(name: "BeatZoneLayout.swift", file: BeatZoneLayout.swift)
            }

            @Step {
                기본 Mesh와 `UnlitMaterial`로 Zone을 만들고 숫자 Label을 자식 Entity로 추가합니다.

                @Code(name: "BeatZoneEntity.swift", file: BeatZoneEntity.swift)
            }
        }
    }

    @Section(title: "경계 진입 판정") {
        @ContentAndMedia {
            손가락이 Zone 안에 머무르는 모든 프레임을 성공으로 처리하면 중복 입력이 발생합니다. 이전 프레임에는 밖이었고 현재 프레임에는 안인 경우만 진입으로 처리합니다.
        }

        @Steps {
            @Step {
                손가락과 현재 목표 중심 사이의 거리를 `simd_distance`로 구하고 판정 반경과 비교합니다.
            }

            @Step {
                `isInside && !wasInsideTarget`일 때만 `true`가 되는 순수 `BeatJudge`를 구현합니다.

                @Code(name: "BeatJudge.swift", file: BeatJudge.swift)
            }

            @Step {
                추적이 유효하지 않으면 판정을 중단하고 이전 위치를 사용하지 않습니다. 추적 복구 직후에는 현재 위치로 내부 상태를 동기화해 가짜 재진입을 막습니다.
            }
        }
    }

    @Section(title: "1→2→3→4 상태 머신") {
        @Steps {
            @Step {
                현재 목표만 진행시키고 다른 Zone의 신규 진입은 `wrongZoneEntered`로 반환합니다.
            }

            @Step {
                성공 직후 짧은 입력 잠금을 적용하고 다음 목표가 바뀔 때 `BeatJudge`를 초기화합니다.
            }

            @Step {
                4박 성공 시 사이클 수와 연속 성공 수를 올리고 목표를 다시 1박으로 돌립니다.

                @Code(name: "BeatSequenceController.swift", file: BeatSequenceController.swift)
            }

            @Step {
                ARKit이나 RealityKit 없이 순서, 중복 방지, 오답 Zone, 추적 유실을 단위 테스트합니다.

                @Code(name: "BeatSequenceControllerTests.swift", file: BeatSequenceControllerTests.swift)
            }
        }
    }
}
