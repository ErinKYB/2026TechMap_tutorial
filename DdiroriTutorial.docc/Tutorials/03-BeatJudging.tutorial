@Tutorial(time: 30) {
    @Intro(title: "Beat Zone과 순서 판정 만들기") {
        RealityKit 공간에 네 개의 Beat Zone을 배치하고, 거리와 바깥에서 안으로 들어오는 경계 진입을 이용해 `1 → 2 → 3 → 4` 순서를 중복 없이 판정합니다.

        @Image(source: ddirori-practice.png, alt: "네 개의 Beat Zone과 연속 성공 표시가 놓인 연습 화면")
    }

    @Section(title: "온보딩과 공유하는 공간 배치") {
        @ContentAndMedia {
            Zone 크기, 간격과 판정 반경을 한 설정에 모읍니다. 시각 반경보다 판정 반경을 조금 크게 두어 실제 손 추적의 흔들림과 사용자별 동작 차이를 흡수합니다.

            @Image(source: ddirori-practice.png, alt: "다이아몬드 모양으로 배치된 네 Beat Zone")
        }

        @Steps {
            @Step {
                `TutorialConfiguration`에 중심, 간격, 시각 반경, 판정 반경과 손 선택 기준을 정의합니다.

                @Code(name: "TutorialConfiguration.swift", file: "judging-configuration.swift")
            }

            @Step {
                `ConductingBeat.allCases`의 정규화 좌표를 RealityKit 공간 좌표로 변환합니다. 같은 원본을 사용하므로 온보딩 경로와 연습 Zone의 모양이 일치합니다.

                @Code(name: "BeatZoneLayout.swift", file: "judging-layout.swift")
            }

            @Step {
                기본 구체 Mesh와 `UnlitMaterial`로 Zone을 만들고 숫자 Label을 자식 Entity로 추가합니다. 현재·완료·대기 상태는 색과 크기를 함께 바꿔 구분합니다.

                @Code(name: "BeatZoneEntity.swift", file: "judging-zone-entity.swift")
            }
        }
    }

    @Section(title: "경계 진입 판정") {
        @ContentAndMedia {
            손가락이 Zone 안에 머무르는 모든 프레임을 성공으로 처리하면 중복 입력이 발생합니다. 이전 프레임에는 밖이었고 현재 프레임에는 안인 경우만 진입으로 처리합니다.
        }

        @Steps {
            @Step {
                손가락과 현재 목표 중심의 거리를 `simd_distance`로 구하고 판정 반경과 비교합니다.
            }

            @Step {
                `isInside && !wasInsideTarget`일 때만 성공하는 순수 `BeatJudge`를 구현합니다.

                @Code(name: "BeatJudge.swift", file: "judging-beat-judge.swift")
            }

            @Step {
                추적이 유효하지 않으면 내부 상태를 바깥으로 되돌립니다. 추적 복구 직후에는 현재 위치로 다시 동기화해 손가락이 목표 안에서 재발견됐을 때 가짜 진입이 생기지 않게 합니다.
            }
        }
    }

    @Section(title: "1→2→3→4 상태 머신") {
        @Steps {
            @Step {
                현재 목표만 진행시키고 다른 Zone의 신규 진입은 `wrongZoneEntered`로 반환합니다. 잘못된 Zone 안에 계속 머무르는 동안은 한 번만 감지합니다.

                @Code(name: "BeatSequenceController.swift", file: "judging-sequence-01.swift")
            }

            @Step {
                성공 직후 짧은 입력 잠금을 적용하고, 목표가 바뀔 때 `BeatJudge`를 초기화합니다. 4박 성공 시 사이클 수를 올리고 목표를 다시 1박으로 돌립니다.

                @Code(name: "BeatSequenceController.swift", file: "judging-sequence-02.swift")
            }

            @Step {
                ARKit이나 RealityKit 없이 순서, 중복 방지, 오답 Zone과 추적 복구를 단위 테스트합니다.

                @Code(name: "BeatSequenceControllerTests.swift", file: "judging-sequence-tests.swift")
            }
        }
    }
}
