l\/03-BeatJudging","title":"Beat Zone과 순서 판정 만들기","type":"topic","url":"\/tutorials\/ddirori-tutorial\/03-beatjudging","role":"project"},"doc://com.erin.DdiroriTutorial/tutorials/Ddirori-Tutorial/01-ProjectSetup":{"kind":"project","estimatedTime":"20min","abstract":[{"type":"text","text":"SwiftUI App lifecycle로 시작 화면과 Immersive Space를 구성하고, 실제 손 추적과 커서 시뮬레이션 중 하나를 선택할 수 있게 만듭니다."}],"identifier":"doc:\/\/com.erin.DdiroriTutorial\/tutorials\/Ddirori-Tutorial\/01-ProjectSetup","title":"visionOS 공간 앱 시작하기","type":"topic","url":"\/tutorials\/ddirori-tutorial\/01-projectsetup","role":"project"},"doc://com.erin.DdiroriTutorial/tutorials/Ddirori-Tutorial/02-HandTracking#%EC%B6%94%EC%A0%81-%EC%84%9C%EB%B9%84%EC%8A%A4%EB%A5%BC-%EC%B6%94%EC%83%81%ED%99%94%ED%95%98%EA%B8%B0":{"role":"pseudoSymbol","type":"section","identifier":"doc:\/\/com.erin.DdiroriTutorial\/tutorials\/Ddirori-Tutorial\/02-HandTracking#%EC%B6%94%EC%A0%81-%EC%84%9C%EB%B9%84%EC%8A%A4%EB%A5%BC-%EC%B6%94%EC%83%81%ED%99%94%ED%95%98%EA%B8%B0","abstract":[{"type":"codeVoice","code":"ARKitSession"},{"text":"과 ","type":"text"},{"type":"codeVoice","code":"HandTrackingProvider"},{"text":"를 실행하고, Hand Anchor와 index finger tip Joint의 변환을 결합해 RealityKit에서 사용할 좌표를 구합니다.","type":"text"}],"url":"\/tutorials\/ddirori-tutorial\/02-handtracking#%EC%B6%94%EC%A0%81-%EC%84%9C%EB%B9%84%EC%8A%A4%EB%A5%BC-%EC%B6%94%EC%83%81%ED%99%94%ED%95%98%EA%B8%B0","title":"추적 서비스를 추상화하기","kind":"section"},"doc://com.erin.DdiroriTutorial/tutorials/Ddirori-Tutorial/02-HandTracking#%EC%8B%A4%EA%B8%B0%EA%B8%B0%EC%97%90%EC%84%9C-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0":{"role":"pseudoSymbol","type":"section","identifier":"doc:\/\/com.erin.DdiroriTutorial\/tutorials\/Ddirori-Tutorial\/02-HandTracking#%EC%8B%A4%EA%B8%B0%EA%B8%B0%EC%97%90%EC%84%9C-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0","abstract":[{"type":"codeVoice","code":"ARKitSession"},{"text":"과 ","type":"text"},{"code":"HandTrackingProvider","type":"codeVoice"},{"text":"를 실행하고, Hand Anchor와 index finger tip Joint의 변환을 결합해 RealityKit에서 사용할 좌표를 구합니다.","type":"text"}],"url":"\/tutorials\/ddirori-tutorial\/02-handtracking#%EC%8B%A4%EA%B8%B0%EA%B8%B0%EC%97%90%EC%84%9C-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0","title":"실기기에서 확인하기","kind":"section"},"ddirori-hero.png":{"variants":[{"url":"\/images\/com.erin.DdiroriTutorial\/ddirori-hero.png","traits":["1x","light"]}],"identifier":"ddirori-hero.png","alt":"반짝이는 파티클이 지휘 궤적을 따라 움직이는 온보딩 화면","type":"image"},"doc://com.erin.DdiroriTutorial/tutorials/Ddirori/--------":{"role":"article","type":"topic","identifier":"doc:\/\/com.erin.DdiroriTutorial\/tutorials\/Ddirori\/--------","abstract":[],"url":"\/tutorials\/ddirori\/--------","title":"공간 앱의 뼈대","kind":"article"},"ob-beat-path-shape.swift":{"fileName":"BeatPathShape.swift","identifier":"ob-beat-path-shape.swift","syntax":"swift","highlights":[],"content":["import SwiftUI","","\/\/\/ 4\/4박자 지휘 패턴을 잇는 닫힌 경로를 그리는 Shape입니다.","\/\/\/ `ConductingPath.normalizedPoints`를 뷰의 크기에 맞게 투영합니다.","struct BeatPathShape: Shape {","    func path(in rect: CGRect) -> Path {","        let center = CGPoint(x: rect.midX, y: rect.midY)","        let radius = min(rect.width, rect.height) \/ 2","","        var path = Path()","        let points = ConductingPath.normalizedPoints.map { normalized in","            CGPoint(","                x: center.x + CGFloat(normalized.x) * radius,","                y: center.y + CGFloat(normalized.y) * radius","            )","        }","","        guard let first = points.first else { return path }","        path.move(to: first)","        for point in points.dropFirst() {","            path.addLine(to: point)","        }","        path.addLine(to: first) \/\/ 4박 → 1박으로 돌아오는 구간을 닫아줍니다.","        return path","    }","}"],"type":"file","fileType":"swift"},"ob-conducting-path.swift":{"fileName":"ConductingPath.swift","identifier":"ob-conducting-path.swift","syntax":"swift","highlights":[],"content":["import simd","","\/\/\/ 지휘 궤적의 정규화 좌표(-1...1)를 다루는 공용 데이터\/함수 모음입니다.","\/\/\/","\/\/\/ SwiftUI 궤적 선(`BeatPathShape`)과 RealityKit 파티클 이미터","\/\/\/ (`ConductingParticleTrailController`)가 모두 이 값을 원본으로 사용해,","\/\/\/ \"같은 경로\"를 서로 다른 좌표계(포인트 \/ 미터)에 각자 투영합니다.","enum ConductingPath {","    \/\/\/ 1 → 2 → 3 → 4 순서의 닫힌 경로 좌표. (4박 다음은 다시 1박으로 이어집니다)","    static let normalizedPoints: [SIMD2<Float>] = ConductingBeat.allCases.map(\\.normalizedOffset)","","    \/\/\/ 0...1 진행률(t)에 해당하는 정규화 좌표를 선형 보간으로 계산합니다.","    \/\/\/ t가 1을 넘어가거나 음수여도 자동으로 0...1 범위로 감싸져 반복 재생을 지원합니다.","    static func position(atProgress t: Float) -> SIMD2<Float> {","        let count = normalizedPoints.count","        guard count > 1 else { return normalizedPoints.first ?? .zero }","","        \/\/ 0..<1 범위로 감싸서 무한 반복을 지원합니다.","        let wrapped = t - t.rounded(.down)","        let scaled = wrapped * Float(count)","        let index = min(Int(scaled), count - 1)","        let localT = scaled - Float(index)","","        let start = normalizedPoints[index]","        let end = normalizedPoints[(index + 1) % count]","        return simd_mix(start, end, SIMD2(repeating: localT))","    }","}"],"type":"file","fileType":"swift"},"doc://com.erin.DdiroriTutorial/tutorials/Ddirori-Tutorial/01-ProjectSetup#%ED%94%84%EB%A1%9C%EC%A0%9D%ED%8A%B8%EC%99%80-Scene-%EA%B5%AC%EC%84%B1":{"role":"pseudoSymbol","type":"section","identifier":"doc:\/\/com.erin.DdiroriTutorial\/tutorials\/Ddirori-Tutorial\/01-ProjectSetup#%ED%94%84%EB%A1%9C%EC%A0%9D%ED%8A%B8%EC%99%80-Scene-%EA%B5%AC%EC%84%B1","abstract":[{"type":"text","text":"SwiftUI App lifecycle로 시작 화면과 Immersive Space를 구성하고, 실제 손 추적과 커서 시뮬레이션 중 하나를 선택할 수 있게 만듭니다."}],"url":"\/tutorials\/ddirori-tutorial\/01-projectsetup#%ED%94%84%EB%A1%9C%EC%A0%9D%ED%8A%B8%EC%99%80-Scene-%EA%B5%AC%EC%84%B1","title":"프로젝트와 Scene 구성","kind":"section"},"doc://com.erin.DdiroriTutorial/tutorials/Ddirori-Tutorial/OnboardingUI#RealityKit-%ED%8C%8C%ED%8B%B0%ED%81%B4%EB%A1%9C-%EA%B6%A4%EC%A0%81-%EC%9C%84%EC%97%90-%EB%B0%98%EC%A7%9D%EC%9D%B4%EB%8A%94-%EA%B0%80%EB%A3%A8-%ED%