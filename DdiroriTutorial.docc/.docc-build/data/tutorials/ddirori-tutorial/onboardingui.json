%B8%B0","kind":"task"},{"reference":"doc:\/\/com.erin.DdiroriTutorial\/tutorials\/Ddirori-Tutorial\/02-HandTracking#ARKit-Hand-Tracking-%EC%8B%A4%ED%96%89%ED%95%98%EA%B8%B0","kind":"task"},{"reference":"doc:\/\/com.erin.DdiroriTutorial\/tutorials\/Ddirori-Tutorial\/02-HandTracking#%EC%8B%A4%EA%B8%B0%EA%B8%B0%EC%97%90%EC%84%9C-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0","kind":"task"}],"reference":"doc:\/\/com.erin.DdiroriTutorial\/tutorials\/Ddirori-Tutorial\/02-HandTracking"}]},{"reference":"doc:\/\/com.erin.DdiroriTutorial\/tutorials\/Ddirori\/------------","projects":[{"sections":[{"reference":"doc:\/\/com.erin.DdiroriTutorial\/tutorials\/Ddirori-Tutorial\/03-BeatJudging#%EC%A1%B0%EC%A0%95-%EA%B0%80%EB%8A%A5%ED%95%9C-%EA%B3%B5%EA%B0%84-%EB%B0%B0%EC%B9%98","kind":"task"},{"reference":"doc:\/\/com.erin.DdiroriTutorial\/tutorials\/Ddirori-Tutorial\/03-BeatJudging#%EA%B2%BD%EA%B3%84-%EC%A7%84%EC%9E%85-%ED%8C%90%EC%A0%95","kind":"task"},{"reference":"doc:\/\/com.erin.DdiroriTutorial\/tutorials\/Ddirori-Tutorial\/03-BeatJudging#1%E2%86%922%E2%86%923%E2%86%924-%EC%83%81%ED%83%9C-%EB%A8%B8%EC%8B%A0","kind":"task"}],"reference":"doc:\/\/com.erin.DdiroriTutorial\/tutorials\/Ddirori-Tutorial\/03-BeatJudging"},{"sections":[{"reference":"doc:\/\/com.erin.DdiroriTutorial\/tutorials\/Ddirori-Tutorial\/04-TutorialExperience#%EC%8B%9C%EB%AE%AC%EB%A0%88%EC%9D%B4%ED%84%B0-%EC%9E%85%EB%A0%A5-%EC%A0%9C%EA%B3%B5%ED%95%98%EA%B8%B0","kind":"task"},{"reference":"doc:\/\/com.erin.DdiroriTutorial\/tutorials\/Ddirori-Tutorial\/04-TutorialExperience#%EC%83%81%ED%83%9C%EC%99%80-%ED%99%94%EB%A9%B4-%EC%97%B0%EA%B2%B0%ED%95%98%EA%B8%B0","kind":"task"},{"reference":"doc:\/\/com.erin.DdiroriTutorial\/tutorials\/Ddirori-Tutorial\/04-TutorialExperience#%EB%91%90-%ED%99%98%EA%B2%BD%EC%97%90%EC%84%9C-%EA%B2%80%EC%A6%9D%ED%95%98%EA%B8%B0","kind":"task"}],"reference":"doc:\/\/com.erin.DdiroriTutorial\/tutorials\/Ddirori-Tutorial\/04-TutorialExperience"}]}],"paths":[["doc:\/\/com.erin.DdiroriTutorial\/tutorials\/Ddirori","doc:\/\/com.erin.DdiroriTutorial\/tutorials\/Ddirori\/$volume","doc:\/\/com.erin.DdiroriTutorial\/tutorials\/Ddirori\/--------"]],"reference":"doc:\/\/com.erin.DdiroriTutorial\/tutorials\/Ddirori"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[{"kind":"hero","chapter":"공간 앱의 뼈대","image":"ddirori-hero.png","backgroundImage":"ddirori-hero.png","estimatedTimeInMinutes":20,"title":"반짝이는 궤적으로 지휘 자세 안내하기","content":[{"inlineContent":[{"text":"본격적으로 손동작을 인식하기 전에, 사용자에게 먼저 4\/4박자 지휘 패턴이","type":"text"},{"text":" ","type":"text"},{"text":"어떻게 움직이는지 보여주는 온보딩 화면을 만듭니다. ","type":"text"},{"type":"codeVoice","code":"WindowGroup"},{"text":"(평범한 창)","type":"text"},{"text":" ","type":"text"},{"text":"안에서 SwiftUI로 궤적 선을 반복 재생하고, 그 위에 RealityKit","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ParticleEmitterComponent"},{"text":"로 반짝이는 파티클이 경로를 따라 흐르게 한 뒤,","type":"text"},{"text":" ","type":"text"},{"text":"“이제 이 동작을 따라해보세요!” 안내와 “시작하기” 버튼으로 마무리합니다.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"몰입형 공간(","type":"text"},{"type":"codeVoice","code":"ImmersiveSpace"},{"text":")으로 가지 않고도, ","type":"text"},{"type":"codeVoice","code":"RealityView"},{"text":"는 평범한 창","type":"text"},{"text":" ","type":"text"},{"text":"안에서도 내부 콘텐츠를 실제 스테레오 깊이감으로 렌더링합니다. 창 자체는","type":"text"},{"text":" ","type":"text"},{"text":"평평하지만 그 안의 3D 콘텐츠는 “창 너머로 보이는 디오라마”처럼 보이므로,","type":"text"},{"text":" ","type":"text"},{"text":"이 온보딩 화면만으로도 visionOS 플랫폼의 공간감을 살릴 수 있습니다.","type":"text"}],"type":"paragraph"}]},{"kind":"tasks","tasks":[{"anchor":"지휘-궤적을-반복-애니메이션으로-그리기","stepsSection":[{"content":[{"inlineContent":[{"type":"text","text":"4\/4박자 각 박자(1박 아래 → 2박 왼쪽 → 3박 오른쪽 → 4박 위)를"},{"type":"text","text":" "},{"code":"ConductingBeat","type":"codeVoice"},{"type":"text","text":" 열거형으로 정의합니다. 좌표는 중심을 기준으로 한"},{"type":"text","text":" "},{"type":"text","text":"정규화 오프셋(-1…1)이며, 4박 다음은 다시 1박으로 이어지는 닫힌"},{"type":"text","text":" "},{"type":"text","text":"경로입니다."}],"type":"paragraph"}],"caption":[],"type":"step","media":null,"code":"ob-conducting-beat.swift","runtimePreview":null},{"content":[{"inlineContent":[{"code":"ConductingPath","type":"codeVoice"},{"type":"text","text":"에 경로 좌표 목록과, 진행률 t(0…1)에 해당하는"},{"type":"text","text":" "},{"type":"text","text":"좌표를 선형 보간으로 계산하는 함수를 추가합니다. t가 1을 넘어가면"},{"type":"text","text":" "},{"type":"text","text":"자동으로 0부터 다시 감싸져 무한 반복을 지원합니다. 이 함수가"},{"type":"text","text":" "},{"type":"text","text":"이후 SwiftUI 선과 RealityKit 파티클 양쪽에서 공유하는 유일한"},{"type":"text","text":" "},{"type":"text","text":"원본이 됩니다."}],"type":"paragraph"}],"caption":[],"type":"step","media":null,"code":"ob-conducting-path.swift","runtimePreview":null},{"content":[{"inlineContent":[{"code":"Shape","type":"codeVoice"},{"type":"text","text":" 프로토콜을 채택한 "},{"code":"BeatPathShape","type":"codeVoice"},{"type":"text","text":"로 "},{"code":"ConductingPath","type":"codeVoice"},{"type":"text","text":"의"},{"type":"text","text":" "},{"type":"text","text":"좌표를 뷰 크기에 맞게 투영해 닫힌 경로를 그립니다."}],"type":"paragraph"}],"caption":[],"type":"step","media":null,"code":"ob-beat-path-shape.swift","runtimePreview":null},{"content":[{"inlineContent":[{"code":"ConductingPathTraceView","type":"codeVoice"},{"type":"text","text":"에서 "},{"code":".trim(from:to:)","type":"codeVoice"},{"type":"text","text":"을 0에서 1까지"},{"type":"text","text":" "},{"type":"text","text":"애니메이션시키고 "},{"code":"repeatForever","type":"codeVoice"},{"type":"text","text":"로 반복시켜, 궤적 선이 계속"},{"type":"text","text":" "},{"type":"text","text":"그려졌다가 다시 처음부터 그려지는 데모 애니메이션을 완성합니다."}],"type":"paragraph"}],"caption":[],"type":"step","media":null,"code":"ob-path-trace-view.swift","runtimePreview":null}],"title":"지휘 궤적을 반복 애니메이션으로 그리기","contentSection":[{"content":[{"inlineContent":[{"type":"text","text":"지휘 궤적 선(SwiftUI)과 파티클(RealityKit)은 서로 다른 렌더링"},{"type":"text","text":" "},{"type":"text","text":"시스템이라, 좌표를 하나의 원본 데이터로 공유하는 것이 핵심입니다."},{"type":"text","text":" "},{"type":"text","text":"먼저 4\/4박자 각 지점을 -1…1 범위의 정규화 좌표로 정의하고, 진행률"},{"type":"text","text":" "},{"type":"text","text":"t(0…1)로 경로 위 아무 지점이나 계산할 수 있는 함수를 만든 뒤,"},{"type":"text","text":" "},{"type":"text","text":"그 경로를 SwiftUI "},{"code":"Path","type":"codeVoice"},{"type":"text","text":"로 그려 반복 재생합니다."}],"type":"paragraph"}],"mediaPosition":"trailing","media":"OnboardingUI1.png","kind":"contentAndMedia"}]},{"anchor":"RealityKit-파티클로-궤적-위에-반짝이는-가루-흘리기","stepsSection":[{"content":[{"inlineContent":[{"type":"text","text":"궤적 선 애니메이션(SwiftUI)과 파티클 이동(RealityKit)이 같은"},{"type":"text","text":" "},{"type":"text","text":"주기로 반복되도록, "},{"code":"ConductingAnimationTiming","type":"codeVoice"},{"type":"text","text":"에 템포와 한 바퀴"},{"type":"text","text":" "},{"type":"text","text":"도는 시간을 공유 상수로 정의합니다."}],"type":"paragraph"}],"caption":[],"type":"step","media":null,"code":"ob-animation-timing.swift","runtimePreview":null},{"content":[{"inlineContent":[{"code":"ConductingWorldMapping","type":"codeVoice"},{"type":"text","text":"으로 정규화 좌표(-1…1)를 RealityKit"},{"type":"text","text":" "},{"type":"text","text":"월드 좌표(미터)로 변환합니다. RealityKit은 +y가 위쪽이라,"},{"type":"text","text":" "},{"type":"text","text":"“아래+“로 정의했던 정규화 좌표의 y 부호를 뒤집어야 궤적 선과"},{"type":"text","text":" "},{"type":"text","text":"파티클이 같은 방향으로 움직입니다."}],"type":"paragraph"}],"caption":[],"type":"step","media":null,"code":"ob-world-mapping.swift","runtimePreview":null},{"content":[{"inlineContent":[{"code":"ConductingParticleTrailController","type":"codeVoice"},{"type":"text","text":"에서 파티클 이미터(“2meter”)를"},{"type":"text","text":" "},{"type":"text","text":"불러와 씬에 추가하고, "},{"code":"content.subscribe(to: SceneEvents.Update.self)","type":"codeVoice"},{"type":"text","text":"로"},{"type":"text","text":" "},{"type":"text","text":"RealityKit의 프레임 콜백을 구독해 매 프레임 이미터 위치를"},{"type":"text","text":" "},{"type":"text","text":"갱신합니다. SwiftUI "},{"code":"@State","type":"codeVoice"},{"type":"text","text":"를 프레임마다 갱신하는 대신 RealityKit"},{"type":"text","text":" "},{"type":"text","text":"자체 루프를 쓰는 이유는 성능 때문입니다."}],"type":"paragraph"}],"caption":[],"type":"step","media":null,"code":"ob-particle-controller.swift","runtimePreview":null},{"content":[{"inlineContent":[{"type":"text","text":"이 컨트롤러를 감싸는 "},{"code":"ConductingParticleTrailView","type":"codeVoice"},{"type":"text","text":"를 만듭니다."},{"type":"text","text":" "},{"code":"RealityView","type":"codeVoice"},{"type":"text","text":"가 평범한 "},{"code":"WindowGroup","type":"codeVoice"},{"type":"text","text":" 안에 놓여도, 그 안의 파티클은"},{"type":"text","text":" "},{"type":"text","text":"여전히 실제 3D 깊이감으로 렌더링됩니다."}],"type":"paragraph"}],"caption":[],"type":"step","media":null,"code":"ob-particle-view.swift","runtimePreview":null}],"title":"RealityKit 파티클로 궤적 위에 반짝이는 가루 흘리기","contentSection":[{"content":[{"inlineContent":[{"type":"text","text":"파티클 이미터는 별도로 Reality Composer Pro에서 제작한"},{"type":"text","text":" "},{"code":"ParticleEmitterComponent","type":"codeVoice"},{"type":"text","text":" 엔티티(“2meter”)를 그대로 불러와"},{"type":"text","text":" "},{"type":"text","text":"사용합니다. 이 파티클을 경로 위에서 움직이게 하려면, 앞 절에서 만든"},{"type":"text","text":" "},{"type":"text","text":"정규화 좌표를 RealityKit의 미터 단위 월드 좌표로 변환하고, 매 프레임"},{"type":"text","text":" "},{"type":"text","text":"이미터의 위치를 갱신해야 합니다."}],"type":"paragraph"}],"mediaPosition":"trailing","media":"OnboardingUI2.png","kind":"contentAndMedia"}]},{"anchor":"안내-문구와-시작하기-버튼으로-온보딩-마무리하기","stepsSection":[{"content":[{"inlineContent":[{"type":"text","text":"“이제 이 동작을 따라해보세요!“에 해당하는 안내 문구와 “시작하기”"},{"type":"text","text":" "},{"type":"text","text":"버튼을 담은 "},{"code":"OnboardingPromptOverlay","type":"codeVoice"},{"type":"text","text":"를 만듭니다. 버튼을 눌렀을"},{"type":"text","text":" "},{"type":"text","text":"때 할 동작은 "},{"code":"onStart","type":"codeVoice"},{"type":"text","text":" 클로저로 바깥에서 주입받습니다."}],"type":"paragraph"}],"caption":[],"type":"step","media":null,"code":"ob-prompt-overlay.swift","runtimePreview":null},{"content":[{"inlineContent":[{"type":"text","text":"마지막으로 "},{"code":"ConductorOnboardingView","type":"codeVoice"},{"type":"text","text":"에서 궤적 선, 파티클,"},{"type":"text","text":" "},{"type":"text","text":"안내 UI 세 레이어를 "},{"code":"ZStack","type":"codeVoice"},{"type":"text","text":"으로 겹쳐 온보딩 화면을 완성합니다."},{"type":"text","text":" "},{"type":"text","text":"이 뷰를 "},{"code":"WindowGroup","type":"codeVoice"},{"type":"text","text":"에 그대로 올리면 됩니다."}],"type":"paragraph"}],"caption":[],"type":"step","media":null,"code":"ob-onboarding-view.swift","runtimePreview":null}],"title":"안내 문구와 시작하기 버튼으로 온보딩 마무리하기","contentSection":[{"content":[{"inlineContent":[{"type":"text","text":"궤적 애니메이션과 파티클 위에 안내 문구와 “시작하기” 버튼을 얹어"},{"type":"text","text":" "},{"type":"text","text":"온보딩 화면을 완성합니다. 배경을 투명하게 유지해, 아래 겹쳐진"},{"type":"text","text":" "},{"type":"text","text":"궤적\/파티클 레이어가 그대로 비치도록 합니다."}],"type":"paragraph"}],"mediaPosition":"trailing","media":"OnboardingUI2.png","kind":"contentAndMedia"}]}]},{"action":{"type":"reference","identifier":"doc:\/\/com.erin.DdiroriTutorial\/tutorials\/Ddirori-Tutorial\/02-HandTracking","overridingTitle":"Get started","isActive":true,"overridingTitleInlineContent":[{"text":"Get started","type":"text"}]},"title":"검지 끝을 공통 공간 좌표로 변환하기","kind":"callToAction","featuredEyebrow":"Tutorial","abstract":[{"type":"codeVoice","code":"ARKitSession"},{"type":"text","text":"과 "},{"type":"codeVoice","code":"HandTrackingProvider"},{"type":"text","text":"를 실행하고, Hand Anchor와 index finger tip Joint의 변환을 결합해 RealityKit에서 사용할 좌표를 구합니다."}]}],"metadata":{"category":"Ddirori","title":"반짝이는 궤적으로 지휘 자세 안내하기","role":"project","categoryPathComponent":"Ddirori"},"references":{"doc://com.erin.DdiroriTutorial/tutorials/Ddirori-Tutorial/OnboardingUI":{"title":"반짝이는 궤적으로 지휘 자세 안내하기","estimatedTime":"20min","kind":"project","identifier":"doc:\/\/com.erin.DdiroriTutorial\/tutorials\/Ddirori-Tutorial\/OnboardingUI","role":"project","url":"\/tutorials\/ddirori-tutorial\/onboardingui","type":"topic","abstract":[{"type":"text","text":"본격적으로 손동작을 인식하기 전에, 사용자에게 먼저 4\/4박자 지휘 패턴이"},{"type":"text","text":" "},{"type":"text","text":"어떻게 움직이는지 보여주는 온보딩 화면을 만듭니다. "},{"type":"codeVoice","code":"WindowGroup"},{"type":"text","text":"(평범한 창)"},{"type":"text","text":" "},{"type":"text","text":"안에서 SwiftUI로 궤적 선을 반복 재생하고, 그 위에 RealityKit"},{"type":"text","text":" "},{"type":"codeVoice","code":"ParticleEmitterComponent"},{"type":"text","text":"로 반짝이는 파티클이 경로를 따라 흐르게 한 뒤,"},{"type":"text","text":" "},{"type":"text","text":"“이제 이 동작을 따라해보세요!” 안내와 “시작하기” 버튼으로 마무리합니다."}]},"ob-animation-timing.swift":{"fileName":"ConductingAnimationTiming.swift","identifier":"ob-animation-timing.swift","syntax":"swift","highlights":[],"content":["import Foundation","","\/\/\/ 궤적 선 애니메이션(SwiftUI)과 파티클 이동(RealityKit)이 함께 참조하는","\/\/\/ 타이밍 상수입니다. 두 애니메이션은 서로 다른 시스템에서 독립적으로 돌지만,","\/\/\/ 이 값을 공유해 시작 시점과 한 바퀴 도는 주기를 맞춥니다.","enum ConductingAnimationTiming {","    \/\/\/ 지휘 속도 (분당 박자 수)","    static let tempo: Double = 76","","    \/\/\/ 박자 하나가 진행되는 시간(초)","    static var beatInterval: TimeInterval { 60.0 \/ tempo }","","    \/\/\/ 궤적을 한 바퀴(1 → 2 → 3 → 4 → 1) 도는 데 걸리는 시간(초)","    static var loopDuration: TimeInterval {","        beatInterval * Double(ConductingBeat.allCases.count)","    }","}"],"type":"file","fileType":"swift"},"OnboardingUI1.png":{"variants":[{"url":"\/images\/com.erin.DdiroriTutorial\/OnboardingUI1.png","traits":["1x","light"]}],"identifier":"OnboardingUI1.png","alt":"4\/4박자 지휘 패턴 경로 다이어그램","type":"image"},"OnboardingUI2.png":{"variants":[{"url":"\/images\/com.erin.DdiroriTutorial\/OnboardingUI2.png","traits":["1x","light"]}],"identifier":"OnboardingUI2.png","alt":"안내 문구와 시작하기 버튼이 있는 완성 화면","type":"image"},"ob-world-mapping.swift":{"fileName":"ConductingWorldMapping.swift","identifier":"ob-world-mapping.swift","syntax":"swift","highlights":[],"content":["import simd","","\/\/\/ 정규화 좌표(-1...1)를 RealityKit 월드 좌표(미터)로 변환합니다.","\/\/\/","\/\/\/ SwiftUI 쪽(`BeatPathShape`)은 같은 정규화 좌표를 포인트 단위로 투영하고,","\/\/\/ 이 파일은 파티클 쪽에서 미터 단위로 투영하는 역할을 맡습니다 — 즉 하나의","\/\/\/ 경로 데이터(`ConductingPath`)를 두 좌표계로 나눠 쓰는 지점입니다.","enum ConductingWorldMapping {","    \/\/\/ 정규화 좌표 1.0이 몇 미터에 대응하는지를 나타내는 값입니다.","    \/\/\/ WindowGroup 안 RealityView의 실제 크기에 맞춰 조정하세요.","    static let defaultWorldScale: Float = 0.08","","    \/\/\/ 진행률(t)에 해당하는 파티클 이미터의 월드 좌표(x, y, z=0)를 계산합니다.","    static func worldPosition(atProgress t: Float, scale: Float = defaultWorldScale) -> SIMD3<Float> {","        let normalized = ConductingPath.position(atProgress: t)","        \/\/ RealityKit은 +y가 위쪽입니다. \"아래+\"로 정의한 SwiftUI 정규화 좌표의","        \/\/ y 부호를 뒤집어야 궤적 선과 파티클이 같은 방향으로 움직입니다.","        return SIMD3(normalized.x * scale, -normalized.y * scale, 0)","    }","}"],"type":"file","fileType":"swift"},"doc://com.erin.DdiroriTutorial/tutorials/Ddirori-Tutorial/02-HandTracking":{"kind":"project","estimatedTime":"25min","abstract":[{"type":"codeVoice","code":"ARKitSession"},{"type":"text","text":"과 "},{"type":"codeVoice","code":"HandTrackingProvider"},{"type":"text","text":"를 실행하고, Hand Anchor와 index finger tip Joint의 변환을 결합해 RealityKit에서 사용할 좌표를 구합니다."}],"identifier":"doc:\/\/com.erin.DdiroriTutorial\/tutorials\/Ddirori-Tutorial\/02-HandTracking","title":"검지 끝을 공통 공간 좌표로 변환하기","type":"topic","url":"\/tutorials\/ddirori-tutorial\/02-handtracking","role":"project"},"doc://com.erin.DdiroriTutorial/tutorials/Ddirori-Tutorial/03-BeatJudging#%EA%B2%BD%EA%B3%84-%EC%A7%84%EC%9E%85-%ED%8C%90%EC%A0%95":{"role":"pseudoSymbol","type":"section","identifier":"doc:\/\/com.erin.DdiroriTutorial\/tutorials\/Ddirori-Tutorial\/03-BeatJudging#%EA%B2%BD%EA%B3%84-%EC%A7%84%EC%9E%85-%ED%8C%90%EC%A0%95","abstract":[{"text":"RealityKit 공간에 네 개의 Beat Zone을 배치하고, 거리와 바깥→안쪽 경계 진입을 이용해 ","type":"text"},{"code":"1 → 2 → 3 → 4","type":"codeVoice"},{"type":"text","text":" 순서를 중복 없이 판정합니다."}],"url":"\/tutorials\/ddirori-tutorial\/03-beatjudging#%EA%B2%BD%EA%B3%84-%EC%A7%84%EC%9E%85-%ED%8C%90%EC%A0%95","title":"경계 진입 판정","kind":"section"},"ob-conducting-beat.swift":{"fileName":"ConductingBeat.swift","identifier":"ob-conducting-beat.swift","syntax":"swift","highlights":[],"content":["import simd","","\/\/\/ 4\/4박자 지휘 패턴의 각 박자를 나타냅니다.","\/\/\/ 1박(아래) → 2박(왼쪽) → 3박(오른쪽) → 4박(위) 순서로 진행되며,","\/\/\/ 4박 다음은 다시 1박으로 이어지는 닫힌 경로입니다.","enum ConductingBeat: Int, CaseIterable {","    case one = 1   \/\/ 아래로","    case two       \/\/ 왼쪽으로 (지휘자 기준 안쪽)","    case three     \/\/ 오른쪽으로 (지휘자 기준 바깥쪽)","    case four      \/\/ 위로","","    \/\/\/ 중심을 기준으로 한 정규화 좌표. x, y 모두 -1...1 범위입니다.","    \/\/\/ (x: 오른쪽+, y: 아래+ — SwiftUI 좌표계 기준)","    var normalizedOffset: SIMD2<Float> {","        switch self {","        case .one:   return SIMD2(0,     1.0)","        case .two:   return SIMD2(-0.85, 0.35)","        case .three: return SIMD2(0.85,  0.35)","        case .four:  return SIMD2(0,    -1.0)","        }","    }","}"],"type":"file","fileType":"swift"},"ob-particle-controller.swift":{"fileName":"ConductingParticleTrailController.swift","identifier":"ob-particle-controller.swift","syntax":"swift","highlights":[],"content":["import SwiftUI","import RealityKit","import Foundation","import RealityKitContent","\/\/ ⚠️ 위 `RealityKitContent`는 Xcode visionOS App 템플릿이 기본으로 만들어주는","\/\/ Reality Composer Pro 패키지 이름을 가정한 것입니다. 프로젝트 내비게이터에서","\/\/ 이 패키지 이름이 다르게 되어 있다면(예: 프로젝트 이름을 따라 자동으로 바뀐 경우),","\/\/ 위 import 문을 실제 이름으로 바꿔주세요.","","\/\/\/ Reality Composer Pro에서 만든 파티클 이미터(\"2meter\")를 불러와,","\/\/\/ 매 프레임 지휘 경로를 따라 위치를 갱신하는 컨트롤러입니다.","\/\/\/","\/\/\/ `ConductingParticleTrailView`의 `RealityView` `make` 클로저에서","\/\/\/ `start(in:)`을 한 번 호출해 사용하세요.","@MainActor","final class ConductingParticleTrailController {","    private let emitterEntityName: String","    private let worldScale: Float","    private let loopDuration: TimeInterval","","    private var emitterEntity: Entity?","    private var elapsedTime: TimeInterval = 0","    \/\/ content.subscribe(to:_:)는 Combine의 Cancellable이 아니라","    \/\/ RealityKit 자체의 EventSubscription을 반환합니다.","    private var updateSubscription: EventSubscription?","","    init(","        emitterEntityName: String = \"2meter\",","        worldScale: Float = ConductingWorldMapping.defaultWorldScale,","        loopDuration: TimeInterval = ConductingAnimationTiming.loopDuration","    ) {","        self.emitterEntityName = emitterEntityName","        self.worldScale = worldScale","        self.loopDuration = loopDuration","    }","","    \/\/\/ 이미터를 씬에 불러와 추가하고, 매 프레임 위치 갱신 구독을 시작합니다.","    func start(in content: RealityViewContent) async {","        await loadEmitterIfNeeded(into: content)","        subscribeToUpdates(content: content)","    }","","    \/\/\/ 뷰가 사라질 때 호출해 프레임 구독을 정리합니다.","    \/\/\/ EventSubscription은 참조가 사라지면(deinit) 자동으로 구독이 해제되므로","    \/\/\/ nil을 대입하는 것만으로 정리됩니다.","    func stop() {","        updateSubscription = nil","    }","","    private func loadEmitterIfNeeded(into content: RealityViewContent) async {","        guard emitterEntity == nil else { return }","","        do {","            \/\/ \"2meter\"는 Reality Composer Pro에서 만든 파티클 이미터 엔티티 이름입니다.","            let emitter = try await Entity(named: emitterEntityName, in: realityKitContentBundle)","            emitter.position = ConductingWorldMapping.worldPosition(atProgress: 0, scale: worldScale)","            content.add(emitter)","            emitterEntity = emitter","        } catch {","            print(\"파티클 이미터(\\(emitterEntityName)) 로드 실패: \\(error)\")","        }","    }","","    private func subscribeToUpdates(content: RealityViewContent) {","        guard updateSubscription == nil else { return }","        updateSubscription = content.subscribe(to: SceneEvents.Update.self) { [weak self] event in","            self?.advance(deltaTime: event.deltaTime)","        }","    }","","    private func advance(deltaTime: TimeInterval) {","        guard let emitterEntity else { return }","        elapsedTime += deltaTime","","        let progress = Float(elapsedTime \/ loopDuration)","        emitterEntity.position = ConductingWorldMapping.worldPosition(atProgress: progress, scale: worldScale)","    }","}"],"type":"file","fileType":"swift"},"doc://com.erin.DdiroriTutorial/tutorials/Ddirori-Tutorial/02-HandTracking#ARKit-Hand-Tracking-%EC%8B%A4%ED%96%89%ED%95%98%EA%B8%B0":{"role":"pseudoSymbol","type":"section","identifier":"doc:\/\/com.erin.DdiroriTutorial\/tutorials\/Ddirori-Tutorial\/02-HandTracking#ARKit-Hand-Tracking-%EC%8B%A4%ED%96%89%ED%95%98%EA%B8%B0","abstract":[{"type":"codeVoice","code":"ARKitSession"},{"text":"과 ","type":"text"},{"type":"codeVoice","code":"HandTrackingProvider"},{"text":"를 실행하고, Hand Anchor와 index finger tip Joint의 변환을 결합해 RealityKit에서 사용할 좌표를 구합니다.","type":"text"}],"url":"\/tutorials\/ddirori-tutorial\/02-handtracking#ARKit-Hand-Tracking-%EC%8B%A4%ED%96%89%ED%95%98%EA%B8%B0","title":"ARKit Hand Tracking 실행하기","kind":"section"},"doc://com.erin.DdiroriTutorial/tutorials/Ddirori-Tutorial/04-TutorialExperience#%EC%83%81%ED%83%9C%EC%99%80-%ED%99%94%EB%A9%B4-%EC%97%B0%EA%B2%B0%ED%95%98%EA%B8%B0":{"role":"pseudoSymbol","type":"section","identifier":"doc:\/\/com.erin.DdiroriTutorial\/tutorials\/Ddirori-Tutorial\/04-TutorialExperience#%EC%83%81%ED%83%9C%EC%99%80-%ED%99%94%EB%A9%B4-%EC%97%B0%EA%B2%B0%ED%95%98%EA%B8%B0","abstract":[{"text":"가이드 시범, 커서 입력, 검지 파티클, 추적 유실 안내와 세 번 연속 성공을 하나의 상태 모델로 연결합니다.","type":"text"}],"url":"\/tutorials\/ddirori-tutorial\/04-tutorialexperience#%EC%83%81%ED%83%9C%EC%99%80-%ED%99%94%EB%A9%B4-%EC%97%B0%EA%B2%B0%ED%95%98%EA%B8%B0","title":"상태와 화면 연결하기","kind":"section"},"doc://com.erin.DdiroriTutorial/tutorials/Ddirori/------------":{"role":"article","type":"topic","identifier":"doc:\/\/com.erin.DdiroriTutorial\/tutorials\/Ddirori\/------------","abstract":[],"url":"\/tutorials\/ddirori\/------------","title":"박자 판정과 학습 경험","kind":"article"},"ob-prompt-overlay.swift":{"fileName":"OnboardingPromptOverlay.swift","identifier":"ob-prompt-overlay.swift","syntax":"swift","highlights":[],"content":["import SwiftUI","","\/\/\/ 지휘 연습 온보딩 화면의 안내 문구(상단)와 \"시작하기\" 버튼(하단)입니다.","\/\/\/ 배경은 투명하게 두어, 아래에 겹쳐진 궤적 선\/파티클 레이어가 그대로 비칩니다.","struct OnboardingPromptOverlay: View {","    var message: String = \"아래 동작을 참고해,\\n지휘를 연습해 보아요\"","    var buttonTitle: String = \"시작하기\"","    var onStart: () -> Void","","    var body: some View {","        VStack {","            Text(message)","                .font(.title2)","                .multilineTextAlignment(.center)","                .padding(.top, 24)","","            Spacer()","","            Button(buttonTitle, action: onStart)","                .buttonStyle(.borderedProminent)","                .padding(.bottom, 24)","        }","    }","}","","#Preview {","    OnboardingPromptOverlay(onStart: {})","        .frame(width: 400, height: 400)","        .background(.black)","}"],"type":"file","fileType":"swift"},"doc://com.erin.DdiroriTutorial/tutorials/Ddirori-Tutorial/04-TutorialExperience#%EC%8B%9C%EB%AE%AC%EB%A0%88%EC%9D%B4%ED%84%B0-%EC%9E%85%EB%A0%A5-%EC%A0%9C%EA%B3%B5%ED%95%98%EA%B8%B0":{"role":"pseudoSymbol","type":"section","identifier":"doc:\/\/com.erin.DdiroriTutorial\/tutorials\/Ddirori-Tutorial\/04-TutorialExperience#%EC%8B%9C%EB%AE%AC%EB%A0%88%EC%9D%B4%ED%84%B0-%EC%9E%85%EB%A0%A5-%EC%A0%9C%EA%B3%B5%ED%95%98%EA%B8%B0","abstract":[{"text":"가이드 시범, 커서 입력, 검지 파티클, 추적 유실 안내와 세 번 연속 성공을 하나의 상태 모델로 연결합니다.","type":"text"}],"url":"\/tutorials\/ddirori-tutorial\/04-tutorialexperience#%EC%8B%9C%EB%AE%AC%EB%A0%88%EC%9D%B4%ED%84%B0-%EC%9E%85%EB%A0%A5-%EC%A0%9C%EA%B3%B5%ED%95%98%EA%B8%B0","title":"시뮬레이터 입력 제공하기","kind":"section"},"doc://com.erin.DdiroriTutorial/tutorials/Ddirori-Tutorial/01-ProjectSetup#%EC%9E%85%EB%A0%A5-%EB%AA%A8%EB%93%9C-%EA%B2%BD%EA%B3%84-%EB%A7%8C%EB%93%A4%EA%B8%B0":{"role":"pseudoSymbol","type":"section","identifier":"doc:\/\/com.erin.DdiroriTutorial\/tutorials\/Ddirori-Tutorial\/01-ProjectSetup#%EC%9E%85%EB%A0%A5-%EB%AA%A8%EB%93%9C-%EA%B2%BD%EA%B3%84-%EB%A7%8C%EB%93%A4%EA%B8%B0","abstract":[{"text":"SwiftUI App lifecycle로 시작 화면과 Immersive Space를 구성하고, 실제 손 추적과 커서 시뮬레이션 중 하나를 선택할 수 있게 만듭니다.","type":"text"}],"url":"\/tutoria