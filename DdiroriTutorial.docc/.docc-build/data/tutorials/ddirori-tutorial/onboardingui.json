View {","    var emitterEntityName: String = \"2meter\"","    var worldScale: Float = ConductingWorldMapping.defaultWorldScale","","    @State private var controller: ConductingParticleTrailController","","    init(","        emitterEntityName: String = \"2meter\",","        worldScale: Float = ConductingWorldMapping.defaultWorldScale","    ) {","        self.emitterEntityName = emitterEntityName","        self.worldScale = worldScale","        _controller = State(initialValue: ConductingParticleTrailController(","            emitterEntityName: emitterEntityName,","            worldScale: worldScale","        ))","    }","","    var body: some View {","        RealityView { content in","            await controller.start(in: content)","        }","        .onDisappear {","            controller.stop()","        }","    }","}"],"type":"file","fileType":"swift"},"doc://com.erin.DdiroriTutorial/tutorials/Ddirori-Tutorial/04-TutorialExperience":{"kind":"project","estimatedTime":"30min","abstract":[{"type":"text","text":"가이드 시범, 커서 입력, 검지 파티클, 추적 유실 안내와 세 번 연속 성공을 하나의 상태 모델로 연결합니다."}],"identifier":"doc:\/\/com.erin.DdiroriTutorial\/tutorials\/Ddirori-Tutorial\/04-TutorialExperience","title":"시뮬레이터와 완성된 학습 흐름 연결하기","type":"topic","url":"\/tutorials\/ddirori-tutorial\/04-tutorialexperience","role":"project"},"doc://com.erin.DdiroriTutorial/tutorials/Ddirori-Tutorial/OnboardingUI#%EC%A7%80%ED%9C%98-%EA%B6%A4%EC%A0%81%EC%9D%84-%EB%B0%98%EB%B3%B5-%EC%95%A0%EB%8B%88%EB%A9%94%EC%9D%B4%EC%85%98%EC%9C%BC%EB%A1%9C-%EA%B7%B8%EB%A6%AC%EA%B8%B0":{"role":"pseudoSymbol","type":"section","identifier":"doc:\/\/com.erin.DdiroriTutorial\/tutorials\/Ddirori-Tutorial\/OnboardingUI#%EC%A7%80%ED%9C%98-%EA%B6%A4%EC%A0%81%EC%9D%84-%EB%B0%98%EB%B3%B5-%EC%95%A0%EB%8B%88%EB%A9%94%EC%9D%B4%EC%85%98%EC%9C%BC%EB%A1%9C-%EA%B7%B8%EB%A6%AC%EA%B8%B0","abstract":[{"type":"text","text":"본격적으로 손동작을 인식하기 전에, 사용자에게 먼저 4\/4박자 지휘 패턴이"},{"type":"text","text":" "},{"type":"text","text":"어떻게 움직이는지 보여주는 온보딩 화면을 만듭니다